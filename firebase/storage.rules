rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // EDUCARE COACHING CLASSES - FIREBASE STORAGE SECURITY RULES
    // Path: /receipts/{studentId}/{receiptFileName}
    // =========================================================================

    function isTeacher() {
      return request.auth != null && (
        request.auth.token.phone_number == '+919876500001' ||
        request.auth.token.phone_number == '+919876500002'
      );
    }

    match /receipts/{studentId}/{fileName} {
      // Teachers can upload, overwrite, and delete PDF receipts
      allow write: if isTeacher() &&
        request.resource.contentType.matches('application/pdf') &&
        request.resource.size < 10 * 1024 * 1024; // 10MB limit

      // Parents can read/download if authenticated and matched to student in Firestore
      // (or via token / signed download URL generated by the Cloud Function / Storage SDK)
      allow read: if isTeacher() || (
        request.auth != null &&
        firestore.get(/databases/(default)/documents/students/$(studentId)).data.parent_phone == request.auth.token.phone_number
      );
    }
  }
}
